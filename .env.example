# MAS Environment Configuration
# Copy this file to .env at the repository root and fill in all required values
# before running docker compose or mas/infra/compose/mas.sh.

# Required

# PostgreSQL password for mas_user
POSTGRES_PASSWORD=changeme

# MinIO root password (also used as MINIO_SECRET_KEY for agents)
MINIO_ROOT_PASSWORD=changeme

# Redis password for router_user
ROUTER_PASSWORD=changeme

# Redis password for toolcache_user
TOOLCACHE_PASSWORD=changeme

# Secret for authenticating agent WebSocket connections
ROUTER_SECRET=changeme

# Secret for tool-service API authentication
TOOL_SECRET=changeme

# LLM Gateway configuration
# litellm = route normal calls through LiteLLM, which forwards to OmniRoute.
# Use legacy:<model> only for temporary direct-provider rollback tests.
LLM_BACKEND=litellm
LLM_GATEWAY_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-change-me
LLM_API_KEY=sk-litellm-change-me
LITELLM_SALT_KEY=change-me
OMNIROUTE_API_KEY=sk-omniroute-internal
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
OMNIROUTE_IMAGE=diegosouzapw/omniroute:3.8.38
AIAT_OMNIROUTE_BOOTSTRAP=true
NINEROUTER_VERSION=0.5.12
CLIPROXYAPI_VERSION=7.2.43
# Required only after OmniRoute management authentication is enabled.
# OMNIROUTE_MANAGEMENT_KEY=
PRICING_SYNC_ENABLED=true
OMNIROUTE_REQUEST_TIMEOUT_MS=120000

# Browser-facing analytics shortcuts shown in the AIAT dashboard.
# Override these when the stack is accessed through a remote host or reverse proxy.
LITELLM_DASHBOARD_URL=http://localhost:4001/ui/
OMNIROUTE_DASHBOARD_URL=http://localhost:20128/dashboard/analytics

# Dashboard credentials
DASHBOARD_USERNAME=admin
# Development default is password "admin"; replace before production.
DASHBOARD_PASSWORD_HASH='$2a$12$pY0fAx51G5Ixd.h2OW.z2eS4pMf3zJ/k2EOEYv7VS3DR2/BR2UT5G'

# JWT signing secret for dashboard sessions
JWT_SECRET=changeme-in-production

# API key for MAS
MAS_API_KEY=changeme

# Optional

# Default LLM model
LLM_DEFAULT_MODEL=auto

# Provider API keys read by mas-core provider modules at runtime
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# MINIMAX_API_KEY=
# NVIDIA_API_KEY=

# OpenCode API key (default: public)
# OPENCODE_API_KEY=public

# Tool adapter overrides. The shipped defaults provide deterministic code
# review, OpenTofu plan-only/local Docker planning, Prometheus configuration,
# and the reviewed read-only workspace MCP server.
# TOOL_CODE_REVIEW_COMMAND=aiat-code-review --json-stdin
# TOOL_INFRA_PROVISION_COMMAND=aiat-devops-adapter infra --json-stdin
# TOOL_MONITORING_SETUP_COMMAND=aiat-devops-adapter monitoring --json-stdin
# AIAT_MCP_SERVERS_JSON={"workspace":{"transport":"stdio","command":"python","args":["-m","tool_service.mcp_workspace_server"]}}

# Enable only after Docker has a registered runsc runtime and the tool-service
# has controlled Docker access. The adapter never falls back to runc.
# TOOL_SANDBOX_COMMAND=aiat-sandbox-runner --json-stdin
# AIAT_SANDBOX_IMAGE=mas/tool-service:latest

# Production

# Set to "production" to enable strict credential validation
# MAS_ENVIRONMENT=production
