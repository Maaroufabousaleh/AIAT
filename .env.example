# MAS Environment Configuration
# Copy this file to .env at the repository root and fill in all required values
# before running docker compose or mas/infra/compose/mas.sh.

# Required

# PostgreSQL password for mas_user
POSTGRES_PASSWORD=changeme

# MinIO root password (kept inside the control-plane/object-storage services)
MINIO_ROOT_PASSWORD=changeme

# Redis password for router_user
ROUTER_PASSWORD=changeme

# Redis password for toolcache_user
TOOLCACHE_PASSWORD=changeme

# Secret for authenticating agent WebSocket connections
ROUTER_SECRET=changeme

# Secret for tool-service API authentication
TOOL_SECRET=changeme

# LLM Gateway configuration
# litellm = route normal calls through LiteLLM, which forwards to OmniRoute.
# Use legacy:<model> only for temporary direct-provider rollback tests.
LLM_BACKEND=litellm
LLM_GATEWAY_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-change-me
LLM_API_KEY=sk-litellm-change-me
LITELLM_SALT_KEY=change-me
OMNIROUTE_API_KEY=sk-omniroute-internal
# `mas/infra/compose/mas.sh` supplies development-only defaults for these
# image names when the *_IMAGE_REF variables are omitted. A production or
# release Compose invocation must instead set every immutable *_IMAGE_REF
# listed in `mas/infra/compose/production-image-lock.example.env`.
# LITELLM_IMAGE_REF=ghcr.io/berriai/litellm:<version>@sha256:<64-hex-digest>
# OMNIROUTE_IMAGE_REF=diegosouzapw/omniroute:<version>@sha256:<64-hex-digest>
# Legacy development-only aliases (used by mas.sh when the refs are omitted):
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
OMNIROUTE_IMAGE=diegosouzapw/omniroute:3.8.38
AIAT_OMNIROUTE_BOOTSTRAP=true
NINEROUTER_VERSION=0.5.12
CLIPROXYAPI_VERSION=7.2.43
# Required only after OmniRoute management authentication is enabled.
# OMNIROUTE_MANAGEMENT_KEY=
PRICING_SYNC_ENABLED=true
OMNIROUTE_REQUEST_TIMEOUT_MS=120000

# Browser-facing analytics shortcuts shown in the AIAT dashboard.
# Override these when the stack is accessed through a remote host or reverse proxy.
LITELLM_DASHBOARD_URL=http://localhost:4001/ui/
OMNIROUTE_DASHBOARD_URL=http://localhost:20128/dashboard/analytics

# Dashboard credentials
DASHBOARD_USERNAME=admin
# Development default is password "admin"; replace before production.
DASHBOARD_PASSWORD_HASH='$2a$12$pY0fAx51G5Ixd.h2OW.z2eS4pMf3zJ/k2EOEYv7VS3DR2/BR2UT5G'

# JWT signing secret for dashboard sessions
JWT_SECRET=changeme-in-production

# API key for MAS
MAS_API_KEY=changeme
AIAT_OPERATOR_API_KEY=change-me-with-a-separate-operator-secret
PM_GATEWAY_API_KEY=change-me-with-a-separate-gateway-secret
# Distinct automation principals. The development wrapper supplies local-only
# fallbacks when these are omitted; production must set real unique secrets.
AIAT_CEO_API_KEY=change-me-with-a-separate-ceo-secret
AIAT_WORKER_API_KEY=change-me-with-a-separate-worker-secret

# Provider webhook ingress and bounded outbox trigger
PM_GATEWAY_PORT=8010
PM_GATEWAY_ENVIRONMENT=production
# Cloudflare Tunnel connector token for the pm-gateway webhook endpoint.
# Store the real value only in the ignored root .env file.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional local Stalwart profile: loopback-only mail sandbox, not a public
# mail deployment. The self-hosted production configuration lives in
# infra/mail-edge.
DEPLOYMENT_TOPOLOGY=local_stalwart_loopback
IDENTITY_PROFILE=development
AGENT_MAIL_DOMAIN=agents.aiat.local
MAIL_HOSTNAME=mail.localhost
STALWART_LOCAL_ADMIN_PORT=18080
STALWART_LOCAL_SMTP_PORT=2525
STALWART_LOCAL_PUBLIC_URL=http://localhost:18080
# Set only for local bootstrap/recovery, then remove it.
STALWART_RECOVERY_ADMIN=
PM_GATEWAY_OUTBOX_INTERVAL_SECONDS=5
PM_GATEWAY_WEBHOOK_BODY_MAX_BYTES=1048576

# YouTrack provider-control-plane selectors. These are references and URLs,
# never raw provider tokens. Store the referenced values only in the managed
# credentials store and the ignored root .env as appropriate.
YOUTRACK_BASE_URL=https://aiat.youtrack.cloud
YOUTRACK_CREDENTIAL_REF=youtrack-aiat-token
YOUTRACK_WEBHOOK_SECRET_REF=youtrack-webhook-current
YOUTRACK_WEBHOOK_HEADER=X-YouTrack-Token
YOUTRACK_CAPABILITY_PROFILE=pm
PM_GATEWAY_PUBLIC_URL=https://pm-gateway.aiat.ca

# Persistent production key for the encrypted credential store. A canonical
# Fernet key is preferred; high-entropy base64 material is normalized by the
# credentials manager. Put the real value only in the ignored root .env.
CREDENTIALS_ENCRYPTION_KEY=

# Optional

# Optional PEM bundle for a trusted enterprise TLS interception root. Compose
# mounts this certificate read-only for OmniRoute; never disable TLS verification.
# AIAT_EXTRA_CA_CERT=

# Default LLM model
LLM_DEFAULT_MODEL=auto

# IANA timezone used for operator-facing schedules, prompt timestamps, tool
# clock readings, and dashboard display. Internal persistence remains UTC.
AIAT_COMPANY_TIMEZONE=UTC

# Provider API keys read by mas-core provider modules at runtime
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# MINIMAX_API_KEY=
# NVIDIA_API_KEY=

# OpenCode API key (default: public)
# OPENCODE_API_KEY=public

# Tool adapter overrides. The shipped defaults provide deterministic code
# review, OpenTofu plan-only/local Docker planning, Prometheus configuration,
# and the reviewed read-only workspace MCP server.
# TOOL_CODE_REVIEW_COMMAND=aiat-code-review --json-stdin
# TOOL_SKILLSPECTOR_COMMAND=skillspector scan --json .
# TOOL_INFRA_PROVISION_COMMAND=aiat-devops-adapter infra --json-stdin
# TOOL_MONITORING_SETUP_COMMAND=aiat-devops-adapter monitoring --json-stdin
# AIAT_MCP_SERVERS_JSON={"workspace":{"transport":"stdio","command":"python","args":["-m","tool_service.mcp_workspace_server"]}}
# Host directory mounted as the tool-service workspace (defaults to the repository root).
# AIAT_WORKSPACE_ROOT=../../..

# Enable only after Docker has a registered runsc runtime and the tool-service
# has controlled Docker access. The adapter never falls back to runc.
# TOOL_SANDBOX_COMMAND=aiat-sandbox-runner --json-stdin
# AIAT_SANDBOX_IMAGE=mas/tool-service:dev

# Production

# Set to "production" to enable strict credential validation
# MAS_ENVIRONMENT=production
