# Candidate evaluation only. This does not replace the governed worker image.
# No multi-stage build is needed: the worker has no build-time dependencies.
FROM python:3.11.18-alpine3.24@sha256:7fbad8e4652eae0186429a6f26cf5b23e27e8c6fd7ac4d0cfd7a6988cdeea1e1

ARG SOURCE_DATE_EPOCH
ARG AIAT_WORKER_SOURCE_SHA256
ARG AIAT_WORKER_SOURCE_REVISION

# The pinned Python base currently carries a vulnerable krb5-libs package as
# part of its Python runtime dependencies. Upgrade only that inherited package
# to the fixed Alpine release; keep the dependency and its security features.
RUN apk add --no-cache 'krb5-libs=1.22.3-r0' \
    && apk info -v | grep -Fxq 'krb5-libs-1.22.3-r0'

RUN python3 -m pip uninstall --yes setuptools wheel jaraco.context \
    && rm -rf \
        /usr/local/lib/python3.11/site-packages/pip \
        /usr/local/lib/python3.11/site-packages/pip-*.dist-info \
        /usr/local/lib/python3.11/ensurepip \
        /usr/local/bin/pip \
        /usr/local/bin/pip3 \
        /usr/local/bin/pip3.11 \
    && python3 - <<'PY'
import importlib.util

for module in ("pip", "setuptools", "wheel", "ensurepip", "jaraco.context"):
    try:
        present = importlib.util.find_spec(module) is not None
    except ModuleNotFoundError:
        present = False
    if present:
        raise SystemExit(f"unexpected Python packaging module remains: {module}")

import json
import re
import uuid
PY

COPY --chown=65532:65532 aiat_deterministic_file_worker_process.py /opt/aiat-worker/worker.py
RUN test -n "${AIAT_WORKER_SOURCE_SHA256}" \
    && printf '%s' "${AIAT_WORKER_SOURCE_REVISION}" | grep -Eq '^[0-9a-f]{40}$' \
    && printf '%s  %s\n' "${AIAT_WORKER_SOURCE_SHA256}" /opt/aiat-worker/worker.py | sha256sum -c -

LABEL org.opencontainers.image.title="AIAT deterministic file worker" \
      org.opencontainers.image.version="0.1.2-alpine-candidate" \
      org.opencontainers.image.source="https://github.com/Maaroufabousaleh/AIAT" \
      org.opencontainers.image.revision="${AIAT_WORKER_SOURCE_REVISION}" \
      com.aiat.worker.source-sha256="${AIAT_WORKER_SOURCE_SHA256}"

ENV LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/aiat-worker
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/python3", "-I", "-B", "/opt/aiat-worker/worker.py"]
