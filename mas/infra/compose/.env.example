# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running compose.
# NEVER commit .env to source control.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_PASSWORD=change_me_minio

# ── Internal service auth tokens ──────────────────────────────────────────────
ROUTER_SECRET=change_me_router_secret
TOOL_SECRET=change_me_tool_secret

# ── LLM Gateway (OpenAI-compatible provider) ──────────────────────────────────
LLM_GATEWAY_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
