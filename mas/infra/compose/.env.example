# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running compose.
# NEVER commit .env to source control.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_postgres

# ── Redis ACL (Phase 3) ─────────────────────────────────────────────────────
# Redis uses ACL for user-based access control (router_user + toolcache_user)
ROUTER_PASSWORD=change_me_router_password
TOOLCACHE_PASSWORD=change_me_toolcache_password

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_PASSWORD=change_me_minio

# ── Internal service auth tokens ──────────────────────────────────────────────
ROUTER_SECRET=change_me_router_secret
AGENT_TOKEN_SECRET=change_me_router_secret
TOOL_SECRET=change_me_tool_secret

# ── LLM Gateway (OpenAI-compatible provider) ──────────────────────────────────
LLM_GATEWAY_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...

# ── LLM Provider API Keys ────────────────────────────────────────────────────
# OpenAI (paid — gpt-4o, etc.)
OPENAI_API_KEY=sk-...

# Google Gemini (free tier available — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenRouter (free tier available — https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Groq (free tier — ultra-fast LPU inference — https://console.groq.com/keys)
GROQ_API_KEY=

# Cerebras Cloud (free tier — world's fastest inference — https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# Mistral AI (free Experiment tier — https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Cloudflare Workers AI (free 10k neurons/day)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Zen / opencode.ai (no key required — leave blank or set to "public")
OPENCODE_API_KEY=public

# ── CLI-based LLM Providers ──────────────────────────────────────────────────
# GitHub Copilot CLI — no API key needed; uses `copilot` binary on PATH.
# Ensure you are signed in: `copilot auth login`
