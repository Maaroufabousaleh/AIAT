# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running compose.
# NEVER commit .env to source control.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_postgres

# ── Redis ACL (Phase 3) ─────────────────────────────────────────────────────
# Redis uses ACL for user-based access control (router_user + toolcache_user)
ROUTER_PASSWORD=change_me_router_password
TOOLCACHE_PASSWORD=change_me_toolcache_password

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_PASSWORD=change_me_minio

# ── Internal service auth tokens ──────────────────────────────────────────────
ROUTER_SECRET=change_me_router_secret
AGENT_TOKEN_SECRET=change_me_router_secret
TOOL_SECRET=change_me_tool_secret

# ── LLM Gateway (OpenAI-compatible provider) ──────────────────────────────────
LLM_GATEWAY_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
