# MAS Environment Configuration
# Copy this file to .env and fill in all required values before running docker compose up

# ── Required ────────────────────────────────────────────────────────────────────────

# PostgreSQL password for mas_user
POSTGRES_PASSWORD=changeme

# MinIO root password (also used as MINIO_SECRET_KEY for agents)
MINIO_ROOT_PASSWORD=changeme

# Redis password for router_user
ROUTER_PASSWORD=changeme

# Redis password for toolcache_user
TOOLCACHE_PASSWORD=changeme

# Secret for authenticating agent WebSocket connections (ROUTER_SECRET or AGENT_TOKEN_SECRET)
ROUTER_SECRET=changeme

# Secret for tool-service API authentication
TOOL_SECRET=changeme

# LLM Gateway configuration
LLM_GATEWAY_URL=http://llm-gateway:8003
LLM_API_KEY=

# Dashboard credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=

# JWT signing secret for dashboard sessions
JWT_SECRET=changeme-in-production

# API key for MAS
MAS_API_KEY=changeme

# ── Optional ────────────────────────────────────────────────────────────────────────

# Default LLM model (e.g., gpt-4o-mini)
# LLM_DEFAULT_MODEL=gpt-4o-mini

# Provider API keys (read by mas-core provider modules at runtime)
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# OpenCode API key (default: public)
# OPENCODE_API_KEY=public

# ── Production ────────────────────────────────────────────────────────────────────

# Set to "production" to enable strict credential validation
# MAS_ENVIRONMENT=production
