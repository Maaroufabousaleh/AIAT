# Copy this file to a private deployment environment and replace every
# <digest> placeholder with the digest emitted by the signed build/pull.
# Production Compose intentionally has no mutable image fallback.  A tag may
# be retained before @sha256 for human readability, but the digest is the
# identity used by the runtime.
# `infra/compose/mas.sh` is a development-only wrapper and injects local `:dev`
# names when these deployment refs are not exported; that does not change this
# production lock contract.

AIAT_TEAM_RUNNER_IMAGE_REF=registry.example.invalid/aiat/team-runner@sha256:<64-hex-digest>
AIAT_REDIS_ACL_INIT_IMAGE_REF=registry.example.invalid/aiat/redis-acl-init@sha256:<64-hex-digest>
AIAT_MESSAGE_ROUTER_IMAGE_REF=registry.example.invalid/aiat/message-router@sha256:<64-hex-digest>
AIAT_TOOL_SERVICE_IMAGE_REF=registry.example.invalid/aiat/tool-service@sha256:<64-hex-digest>
AIAT_OPENCODE_RUNTIME_IMAGE_REF=registry.example.invalid/aiat/opencode-runtime@sha256:<64-hex-digest>
AIAT_ORCHESTRATOR_IMAGE_REF=registry.example.invalid/aiat/orchestrator-api@sha256:<64-hex-digest>
AIAT_PM_GATEWAY_IMAGE_REF=registry.example.invalid/aiat/pm-gateway@sha256:<64-hex-digest>
AIAT_DASHBOARD_IMAGE_REF=registry.example.invalid/aiat/dashboard@sha256:<64-hex-digest>
OMNIROUTE_IMAGE_REF=registry.example.invalid/aiat/omniroute@sha256:<64-hex-digest>
LITELLM_IMAGE_REF=registry.example.invalid/aiat/litellm@sha256:<64-hex-digest>

# The external base/runtime images in docker-compose.yml are already recorded
# with their current manifest digests. Refresh those digests during the same
# release-ledger run as the application image inventory.
