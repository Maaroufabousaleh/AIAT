# Copy to .env.stalwart-local (ignored) and run scripts/bootstrap-stalwart-local.py.
# The bootstrap script fills the provider/identity values in that ignored
# file; no generated credential, database, or mail state belongs in Git.

IDENTITY_DATABASE_PASSWORD=local-identity-db-change-me
IDENTITY_SERVICE_SECRET=local-identity-service-secret-change-me
IDENTITY_CONTENT_ENCRYPTION_KEY=local-fernet-key-generated-by-bootstrap
IDENTITY_CLIENT_PUBLIC_KEYS_JSON={}
IDENTITY_CLIENT_SCOPES_JSON={}

PRIMARY_DOMAIN=aiat.local
DEPLOYMENT_TOPOLOGY=local_stalwart_loopback
IDENTITY_PROFILE=development
AGENT_MAIL_DOMAIN=agents.aiat.local
MAIL_HOSTNAME=mail.localhost
IDENTITY_LOCAL_PORT=8011

# External delivery is deliberately unavailable in the local profile.
OUTBOUND_RELAY_PROVIDER=disabled
OUTBOUND_RELAY_HOST=
OUTBOUND_RELAY_PORT=0
OUTBOUND_RELAY_TLS_MODE=disabled
OUTBOUND_RELAY_CERTIFIED=false
DIRECT_MX_OUTBOUND_ENABLED=false
DEFAULT_OUTBOUND_ENABLED=false
RESEND_API_KEY=

# The management key is created with only domain/account query/create/update.
STALWART_API_KEY=generated-by-bootstrap
# Local-only Basic auth for the dedicated JMAP service account. Production uses
# a managed OAuth bearer token instead.
STALWART_JMAP_SERVICE_TOKEN=generated-by-bootstrap

AIAT_IDENTITY_CLIENT_ID=operator-laptop
AIAT_IDENTITY_CLIENT_PRIVATE_KEY=generated-by-bootstrap
AIAT_IDENTITY_TOOL_CLIENT_ID=tool-service
AIAT_IDENTITY_TOOL_PRIVATE_KEY=generated-by-bootstrap
