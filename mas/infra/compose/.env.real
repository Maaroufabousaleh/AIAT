# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=mas
POSTGRES_USER=mas_user

# ── PgBouncer ─────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_NAME=mas
DB_USER=mas_user
POOL_MODE=transaction
MAX_CLIENT_CONN=200
DEFAULT_POOL_SIZE=20
SERVER_RESET_QUERY_ALWAYS=0

# ── Connection strings ────────────────────────────────────────────────────────
PGBOUNCER_DSN=postgresql://mas_user:${POSTGRES_PASSWORD}@pgbouncer:5432/mas
