# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://router_user:${ROUTER_PASSWORD}@redis:6379/0
REDIS_USERNAME=router_user

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio_root
MINIO_ENDPOINT=http://minio:9000

# ── Service URLs ──────────────────────────────────────────────────────────────
ROUTER_URL=http://message-router:8001
TOOL_SERVICE_URL=http://tool-service:8002
ORCHESTRATOR_URL=http://orchestrator-api:8000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Team-runner ───────────────────────────────────────────────────────────────
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# ── Message-router tuning ─────────────────────────────────────────────────────
STREAM_PREFIX=stream
GROUP_PREFIX=group
DEDUPE_PREFIX=dedupe
DEDUPE_TTL_SECONDS=300
STREAM_MAX_LEN=50000
TRIM_INTERVAL_SECONDS=60
RECLAIM_IDLE_MS=120000
RECLAIM_INTERVAL_SECONDS=30
MAX_DELIVERY_ATTEMPTS=3
WS_PING_INTERVAL_SECONDS=15
WS_PONG_TIMEOUT_SECONDS=10
READ_COUNT=10
READ_BLOCK_MS=5000
ORCHESTRATOR_STREAM=stream:exec_ceo

# ── Tool-service tuning ───────────────────────────────────────────────────────
CB_FAILURE_THRESHOLD=3
CB_FAILURE_WINDOW_SECONDS=60
CB_OPEN_DURATION_SECONDS=120
HOST=0.0.0.0
PORT=8002

