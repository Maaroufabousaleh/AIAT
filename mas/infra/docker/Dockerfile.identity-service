FROM python:3.11.11-slim@sha256:a8e0a3090316aed0b11037aac613aef32fb1747dcc1dcb5c0f6c727a0113a07f

RUN useradd --system --create-home --uid 10001 aiat
WORKDIR /app

COPY packages/mas-core/ /tmp/mas-core/
COPY apps/identity-service/pyproject.toml /tmp/identity-service/pyproject.toml
COPY apps/identity-service/constraints.txt /tmp/identity-service/constraints.txt
COPY apps/identity-service/identity_service /tmp/identity-service/identity_service
RUN pip install --no-cache-dir --no-deps /tmp/mas-core \
    && pip install --no-cache-dir --constraint /tmp/identity-service/constraints.txt /tmp/identity-service \
    && rm -rf /tmp/identity-service

COPY apps/identity-service/alembic.ini /app/alembic.ini
COPY apps/identity-service/migrations /app/migrations

USER 10001:10001
EXPOSE 8010
CMD ["uvicorn", "identity_service.main:app", "--host", "0.0.0.0", "--port", "8010"]
