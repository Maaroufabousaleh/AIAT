# ── Dockerfile.orchestrator-api ───────────────────────────────────────────────
FROM python:3.11-slim@sha256:90744cff8f32887f075c47d747a173ff333e9e98801667af93c357fa9f5e28ff

# Install docker CLI for log streaming (newer version for API compatibility)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        curl \
    && curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.4.1.tgz -o /tmp/docker.tgz \
    && tar -xzf /tmp/docker.tgz -C /tmp \
    && mv /tmp/docker/docker /usr/local/bin/docker \
    && chmod +x /usr/local/bin/docker \
    && rm -rf /tmp/docker.tgz /tmp/docker \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_TRUSTED_HOST="pypi.org files.pythonhosted.org"

RUN pip install --no-cache-dir uv==0.4.30

COPY packages/mas-core/ /tmp/mas-core/
COPY packages/mas-tools-sdk/ /tmp/mas-tools-sdk/
COPY apps/orchestrator-api/ /tmp/orchestrator-api/
COPY migrations/ /tmp/migrations/

RUN pip install --no-deps /tmp/mas-core && \
    pip install --no-deps /tmp/mas-tools-sdk && \
    pip install "/tmp/orchestrator-api[runtime-default]" && \
    pip install \
        uvicorn \
        httpx \
        fastapi \
        pydantic \
        pydantic-settings \
        redis \
        structlog \
        asyncpg \
        psutil \
        aiolimiter \
        apscheduler \
        pyyaml \
        alembic \
        psycopg2-binary \
        cryptography

RUN python -m venv /opt/semgrep \
    && /opt/semgrep/bin/pip install --no-cache-dir "semgrep==1.168.0" \
    && ln -s /opt/semgrep/bin/semgrep /usr/local/bin/semgrep

# The operator-triggered first-party worker scan runs only the locally pinned
# binary. Verify the release archive before installation; scan-time flags
# disable update checks and secret verification.
RUN curl -fsSL \
        "https://github.com/trufflesecurity/trufflehog/releases/download/v3.97.0/trufflehog_3.97.0_linux_amd64.tar.gz" \
        -o /tmp/trufflehog_3.97.0_linux_amd64.tar.gz \
    && echo "62224de2f9dd7cd418800feb953760a302ed2f82a7c547fe1146a4874fb179e4  /tmp/trufflehog_3.97.0_linux_amd64.tar.gz" | sha256sum -c - \
    && mkdir -p /tmp/trufflehog-release \
    && tar --no-same-owner -xzf /tmp/trufflehog_3.97.0_linux_amd64.tar.gz -C /tmp/trufflehog-release trufflehog \
    && install -m 0755 /tmp/trufflehog-release/trufflehog /usr/local/bin/trufflehog \
    && rm -rf /tmp/trufflehog_3.97.0_linux_amd64.tar.gz /tmp/trufflehog-release

COPY apps/orchestrator-api/orchestrator_api/ /app/orchestrator_api/
COPY migrations/ /app/migrations/
COPY alembic.ini /app/alembic.ini
COPY workers/ /app/workers/
COPY companies/ /app/companies/
# Keep the committed external-worker approval evidence available to the
# fail-closed runtime factory. The API image does not include the repository
# checkout, so source-relative worker manifest refs are normalized to /app/docs.
COPY docs/provenance/openhands-candidate/ /app/docs/provenance/openhands-candidate/
COPY docs/provenance/deterministic_file_worker_build_provenance.json /app/docs/provenance/deterministic_file_worker_build_provenance.json
COPY scripts/check_runtime_adapter_conformance.py /app/scripts/check_runtime_adapter_conformance.py
COPY apps/tool-service/tool_service/semgrep-default.yml /app/semgrep-default.yml

WORKDIR /app

EXPOSE 8000

CMD ["uvicorn", "orchestrator_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
