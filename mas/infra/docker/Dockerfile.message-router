# ── Dockerfile.message-router ─────────────────────────────────────────────────
FROM python:3.11-slim@sha256:90744cff8f32887f075c47d747a173ff333e9e98801667af93c357fa9f5e28ff

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

ENV PIP_TRUSTED_HOST="pypi.org files.pythonhosted.org"

RUN pip install --no-cache-dir uv==0.4.*

COPY packages/mas-core/ /tmp/mas-core/
COPY packages/mas-tools-sdk/ /tmp/mas-tools-sdk/
COPY apps/message-router/ /tmp/message-router/

RUN pip install --no-deps /tmp/mas-core && \
    pip install --no-deps /tmp/mas-tools-sdk && \
    pip install /tmp/message-router && \
    pip install \
        uvicorn \
        httpx \
        fastapi \
        pydantic \
        pydantic-settings \
        redis \
        structlog \
        prometheus-client \
        asyncpg \
        psutil \
        aiolimiter

COPY apps/message-router/message_router/ /app/message_router/

WORKDIR /app

EXPOSE 8001

CMD ["uvicorn", "message_router.main:app", "--host", "0.0.0.0", "--port", "8001"]
