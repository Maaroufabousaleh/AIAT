MAS_ENVIRONMENT=production
IDENTITY_PROFILE=production
PRIMARY_DOMAIN=aiat.ca
AGENT_MAIL_DOMAIN=agents.aiat.ca
MAIL_HOSTNAME=mail.aiat.ca
IDENTITY_HOSTNAME=identity.aiat.ca

# Default v1 provider topology.
IDENTITY_INBOUND_PROVIDER=cloudflare
IDENTITY_OUTBOUND_PROVIDER=resend
CLOUDFLARE_MAIL_EDGE_URL=https://mail-edge.aiat.ca
CLOUDFLARE_MAIL_EDGE_AUTH_SECRET=CHANGE_ME_NARROW_EDGE_SECRET
CLOUDFLARE_MAIL_RETENTION_DAYS=7
CLOUDFLARE_PROCESSED_MAIL_RETENTION_DAYS=1
MAIL_EDGE_STORAGE_BACKEND=d1
MAIL_EDGE_MAX_MESSAGE_BYTES=4194304
MAIL_EDGE_INCOMPLETE_RETENTION_SECONDS=3600
HUMAN_APPROVAL_FOR_OUTBOUND=true

# AIAT identity authority secrets. Values stay in the operator secret store.
IDENTITY_DATABASE_PASSWORD=CHANGE_ME
IDENTITY_SERVICE_SECRET=CHANGE_ME_LONG_RANDOM
IDENTITY_CONTENT_ENCRYPTION_KEY=CHANGE_ME_BASE64_FERNET_KEY
IDENTITY_CLIENT_PUBLIC_KEYS_JSON={}
IDENTITY_CLIENT_SCOPES_JSON={}

# Direct Resend API/webhook path. DEFAULT_OUTBOUND_ENABLED remains false.
RESEND_API_KEY=CHANGE_ME
RESEND_WEBHOOK_SIGNING_SECRET=CHANGE_ME
OUTBOUND_RELAY_PROVIDER=resend
OUTBOUND_RELAY_HOST=smtp.resend.com
OUTBOUND_RELAY_PORT=465
OUTBOUND_RELAY_TLS_MODE=implicit
OUTBOUND_RELAY_CERTIFIED=false
DIRECT_MX_OUTBOUND_ENABLED=false
DEFAULT_OUTBOUND_ENABLED=false

# Kept empty because Stalwart is not constructed in this profile.
STALWART_API_KEY=
STALWART_JMAP_SERVICE_TOKEN=

ACME_EMAIL=operator@example.invalid
