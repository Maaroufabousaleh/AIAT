DEPLOYMENT_TOPOLOGY=oracle_vps_stalwart_resend
PRIMARY_DOMAIN=aiat.ca
AGENT_MAIL_DOMAIN=agents.aiat.ca
MAIL_HOSTNAME=mail.aiat.ca
IDENTITY_HOSTNAME=identity.aiat.ca
PUBLIC_IDENTITY_URL=https://identity.aiat.ca
STALWART_PUBLIC_URL=https://mail.aiat.ca
OUTBOUND_RELAY_PROVIDER=resend
OUTBOUND_RELAY_HOST=smtp.resend.com
OUTBOUND_RELAY_PORT=465
OUTBOUND_RELAY_TLS_MODE=implicit
DIRECT_MX_OUTBOUND_ENABLED=false
DEFAULT_MAILBOX_QUOTA_MB=100
DEFAULT_MAIL_RETENTION_DAYS=180
DEFAULT_OUTBOUND_ENABLED=false

# Secret placeholders only; inject real values outside Git.
IDENTITY_DATABASE_PASSWORD=CHANGE_ME
IDENTITY_SERVICE_SECRET=CHANGE_ME
IDENTITY_CONTENT_ENCRYPTION_KEY=CHANGE_ME_BASE64_FERNET_KEY
STALWART_API_KEY=CHANGE_ME
# OAuth/service bearer used only by identity-service for governed JMAP mail
# operations. It is distinct from the management API key and is never exposed
# to workers, the laptop, dashboard, logs, or API responses.
STALWART_JMAP_SERVICE_TOKEN=CHANGE_ME
# Bootstrap/recovery administrator used only through the loopback SSH tunnel.
STALWART_RECOVERY_ADMIN=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
IDENTITY_CLIENT_PUBLIC_KEYS_JSON={}
IDENTITY_CLIENT_SCOPES_JSON={}
# Enrol at least operator-laptop (identity:admin, identity:delegate) and
# tool-service (identity:delegate, identity:browser-broker). Values are public
# Ed25519 keys only; private signing keys belong only on their callers.
BACKUP_ENCRYPTION_RECIPIENT=age1CHANGE_ME
ACME_EMAIL=operator@example.invalid
PUBLIC_MAIL_IP=203.0.113.10
DKIM_SELECTOR=resend
