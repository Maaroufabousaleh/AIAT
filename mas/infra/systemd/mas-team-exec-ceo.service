[Unit]
Description=MAS team-exec-ceo Service
After=network.target local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mas
EnvironmentFile=-/opt/mas/.env
ExecStart=/usr/local/bin/masctl team-exec-ceo start
ExecStop=/usr/local/bin/masctl team-exec-ceo stop
ExecReload=/usr/local/bin/masctl team-exec-ceo restart
RemainAfterExit=yes
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=30

# Resource limits (adjust based on service needs)
MemoryMax=512M
CPUQuota=50%
# Uncomment for more restrictive sandboxing
# ProtectSystem=full
# ProtectHome=yes
# PrivateTmp=yes
# NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
