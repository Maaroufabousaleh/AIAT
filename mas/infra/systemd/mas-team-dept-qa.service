[Unit]
Description=MAS team-dept-qa Service
After=network.target local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mas
EnvironmentFile=-/opt/mas/.env
ExecStart=/usr/local/bin/masctl team-dept-qa start
ExecStop=/usr/local/bin/masctl team-dept-qa stop
ExecReload=/usr/local/bin/masctl team-dept-qa restart
RemainAfterExit=yes
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=30

MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
