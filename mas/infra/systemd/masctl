#!/bin/bash
# Control one AIAT MAS Compose service from systemd or an operator shell.
# Usage: masctl <service_name> <start|stop|restart|status|logs>

set -euo pipefail

SERVICE_NAME="${1:-}"
COMMAND="${2:-}"
if [ -z "$SERVICE_NAME" ] || [ -z "$COMMAND" ]; then
    echo "Usage: $0 <service_name> <start|stop|restart|status|logs>" >&2
    exit 2
fi

MAS_ROOT="${MAS_ROOT:-/opt/mas}"
COMPOSE_DIR="${MAS_COMPOSE_DIR:-$MAS_ROOT/infra/compose}"
ENV_FILE="${MAS_ENV_FILE:-$MAS_ROOT/.env}"
if [ ! -f "$COMPOSE_DIR/docker-compose.yml" ]; then
    echo "Error: docker-compose.yml not found in $COMPOSE_DIR" >&2
    exit 1
fi
if [ ! -f "$ENV_FILE" ]; then
    echo "Error: environment file not found at $ENV_FILE" >&2
    exit 1
fi

load_env_file() {
    local line key value
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
        key="${line%%=*}"
        value="${line#*=}"
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        export "$key=$value"
    done < "$ENV_FILE"
}

load_env_file
export COMPOSE_DISABLE_ENV_FILE=1
compose=(docker compose -f "$COMPOSE_DIR/docker-compose.yml")
if [ "${MAS_COMPOSE_MODE:-production}" = "dev" ]; then
    if [ ! -f "$COMPOSE_DIR/docker-compose.dev.yml" ]; then
        echo "Error: development Compose overlay not found in $COMPOSE_DIR" >&2
        exit 1
    fi
    compose+=( -f "$COMPOSE_DIR/docker-compose.dev.yml" )
fi

case "$COMMAND" in
    start)
        "${compose[@]}" up -d "$SERVICE_NAME"
        ;;
    stop)
        "${compose[@]}" stop "$SERVICE_NAME"
        ;;
    restart)
        "${compose[@]}" restart "$SERVICE_NAME"
        ;;
    status)
        "${compose[@]}" ps "$SERVICE_NAME"
        ;;
    logs)
        "${compose[@]}" logs -f "$SERVICE_NAME"
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        echo "Valid commands: start, stop, restart, status, logs" >&2
        exit 2
        ;;
esac
