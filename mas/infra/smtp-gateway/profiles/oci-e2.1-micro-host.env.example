# Constrained host-level adoption profile for the supplied 1 OCPU / 1 GiB
# Ubuntu gateway. This profile is not a Docker replacement for the live host;
# host Postfix, wg-quick, and socat remain authoritative.
DEPLOYMENT_TOPOLOGY=smtp_gateway_vps_home_stalwart_resend
GATEWAY_RUNTIME=host_postfix_wireguard
GATEWAY_RUNTIME_PROFILE=oci_e2_1_micro_host
GATEWAY_CONTAINER_RUNTIME=false
GATEWAY_PUBLIC_HOSTNAME=mail.aiat.ca
SMTP_GATEWAY_HOSTNAME=mail.aiat.ca
SMTP_GATEWAY_PUBLIC_IP=<public IPv4 of the gateway VPS>
PUBLIC_MAIL_IP=<public IPv4 of the gateway VPS>
MAIL_HOSTNAME=mail.aiat.ca
IDENTITY_HOSTNAME=identity.aiat.ca
AGENT_MAIL_DOMAIN=agents.aiat.ca
PRIMARY_DOMAIN=aiat.ca
MAS_ENVIRONMENT=production
IDENTITY_PROFILE=production

# Live tunnel facts. Existing private keys are never regenerated or replaced.
WIREGUARD_INTERFACE=aiat-gateway
WIREGUARD_PORT=51820
GATEWAY_WIREGUARD_IP=10.77.0.1
GATEWAY_WIREGUARD_CIDR=10.77.0.1/24
HOME_WIREGUARD_IP=10.77.0.2
HOME_WIREGUARD_CIDR=10.77.0.2/24

# Existing host-level Postfix -> WireGuard socat -> home Stalwart path.
HOST_POSTFIX_CONFIG_DIR=/etc/postfix
HOST_POSTFIX_MAIN_CF=/etc/postfix/main.cf
HOST_POSTFIX_TRANSPORT_FILE=/etc/postfix/transport
HOST_POSTFIX_QUEUE_PATH=/var/spool/postfix
HOST_POSTFIX_SMTP_PORT=25
HOME_STALWART_SMTP_PORT=2525
HOME_STALWART_BIND_ADDRESS=127.0.0.1
HOME_WIREGUARD_RELAY_ADDRESS=10.77.0.2
HOST_POSTFIX_TRANSPORT_TARGET=10.77.0.2:2525
HOME_FORWARD_UNIT=<existing-socat-systemd-unit>

# 1 GiB RAM + 1 GiB swap. These are audit limits, not commands to resize host.
GATEWAY_OCPU=1
GATEWAY_RAM_MB=1024
GATEWAY_SWAP_MB=1024
GATEWAY_BOOT_DISK_GB=45
GATEWAY_POSTFIX_MEMORY_LIMIT_MB=384
GATEWAY_POSTFIX_CPU_LIMIT=0.50

# Fail-closed activation state. These are changed only by a reviewed operator
# evidence update; this repository never changes provider/firewall/DNS state.
PUBLIC_SMTP25_ACTIVATED=false
IDENTITY_DNS_MODE=blocked
IDENTITY_HTTPS_INGRESS_CERTIFIED=false
DIRECT_MX_OUTBOUND_ENABLED=false
DEFAULT_OUTBOUND_ENABLED=false
OUTBOUND_RELAY_HOST=smtp.resend.com
OUTBOUND_RELAY_PORT=465
OUTBOUND_RELAY_TLS_MODE=implicit
OUTBOUND_RELAY_CERTIFIED=false

# Separate evidence files for separate gates.
GATEWAY_EVIDENCE_DIR=/secure/evidence/aiat-smtp-gateway
GATEWAY_HOST_EVIDENCE=/secure/evidence/aiat-smtp-gateway/host-sanitized.txt
GATE_INTERNAL_RELAY_EVIDENCE=/secure/evidence/aiat-smtp-gateway/internal-relay.txt
GATE_EXTERNAL_INBOUND_EVIDENCE=/secure/evidence/aiat-smtp-gateway/external-inbound.txt
GATE_DNS_MX_EVIDENCE=/secure/evidence/aiat-smtp-gateway/dns-mx.txt
GATE_IDENTITY_HTTPS_EVIDENCE=/secure/evidence/aiat-smtp-gateway/identity-https.txt
GATE_RESEND_EVIDENCE=/secure/evidence/aiat-smtp-gateway/resend.txt
