# Review and load on the home AIAT host after replacing interface names.
# The home router must have no TCP/25 port-forward.
define wg_if = "aiat-gateway"
define gateway_wg_ip = 10.77.0.1

table inet aiat_home_filter {
  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state established,related accept
    ip protocol icmp accept
    iifname $wg_if ip saddr $gateway_wg_ip tcp dport { 25, 8080, 8010 } accept
    iifname $wg_if udp dport 51820 accept
    # Existing LAN/SSH rules must remain operator-restricted.
    iifname "<LAN_INTERFACE>" tcp dport 22 ip saddr <OPERATOR_LAN_CIDR> accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
    tcp dport 25 reject with icmpx type admin-prohibited
    ip daddr $gateway_wg_ip tcp dport { 25, 8080, 8010 } accept
  }
}
