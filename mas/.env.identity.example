# Copy selected values into the laptop/control-plane deployment environment.
# Do not copy this file over an existing .env and never commit real secrets.

# Orchestrator: production always requires identity and ignores this override.
# The false value is useful only for a deliberate local development opt-out.
AIAT_IDENTITY_REQUIRED=false
AIAT_COMPANY_ID=00000000-0000-0000-0000-000000000000
IDENTITY_SERVICE_URL=https://identity.aiat.ca
AIAT_IDENTITY_CLIENT_ID=operator-laptop
AIAT_IDENTITY_CLIENT_PRIVATE_KEY=BASE64_ED25519_PRIVATE_KEY

# Tool-service-to-identity signed client. Enrol only identity:delegate and
# identity:browser-broker; the latter permits the internal one-use lease
# handshake and does not expose the lease to a worker response.
AIAT_IDENTITY_TOOL_CLIENT_ID=tool-service
AIAT_IDENTITY_TOOL_PRIVATE_KEY=BASE64_ED25519_PRIVATE_KEY

# Tool-service request authentication in production: each runner signs with
# its own enrolled Ed25519 key and may assert only its matching caller id.
AIAT_TOOL_CLIENT_ID=orchestrator-api
AIAT_TOOL_CLIENT_PRIVATE_KEY=BASE64_ED25519_PRIVATE_KEY
AIAT_TOOL_CALLER_PUBLIC_KEYS_JSON={"orchestrator-api":"BASE64_ED25519_PUBLIC_KEY"}
AIAT_TOOL_DELEGATE_CLIENT_IDS_JSON=["orchestrator-api"]

# Persisted external-account login profiles are operator-laptop only. Generic
# browser research sessions are memory-only.
AIAT_BROWSER_RUNTIME_LOCATION=operator_laptop
AIAT_BROWSER_PROFILE_ROOT=/var/lib/aiat/browser-profiles
